{
  "name": "soulsync-monorepo",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@soulsync/web",
    "dev:api": "npm run dev --workspace=@soulsync/api",
    "build": "turbo run build",
    "test": "pnpm -r test",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "prettier": "^3.5.0"
  },
  "packageManager": "pnpm@10.5.2"
}
