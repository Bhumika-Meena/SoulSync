PORT=8000
ENVIRONMENT=development

# Model Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GROQ_API_KEY=your-groq-api-key

# NestJS Internal Tool Gateway
NEST_API_INTERNAL_URL=http://localhost:4000
INTERNAL_AGENT_SECRET=replace-with-shared-hmac-secret

# PostgreSQL with pgvector (direct connection for read-only semantic retrieval)
DATABASE_URL=postgresql://soulsync:soulsync_dev@localhost:5432/soulsync?schema=public
