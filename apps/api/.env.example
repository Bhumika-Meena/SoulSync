PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Render or local Docker)
DATABASE_URL=postgresql://soulsync:soulsync_dev@localhost:5432/soulsync?schema=public

# JWT Authentication
JWT_SECRET=replace-with-secure-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Internal Agent Service Communication
AGENT_SERVICE_URL=http://localhost:8000
INTERNAL_AGENT_SECRET=replace-with-shared-hmac-secret
