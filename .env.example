# Database (PostgreSQL — RDS compatible)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/soulsync?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email provider (e.g. Resend, Nodemailer) — optional for magic link
# EMAIL_SERVER=""
# EMAIL_FROM=""

# External LLM (e.g. OpenAI — use env name you prefer)
OPENAI_API_KEY=""
# Or: ANTHROPIC_API_KEY=""

# Wellness Guide AI (Groq — optional, used if set)
GROQ_API_KEY="Groq API key here (optional, used if set)"

# App
NODE_ENV="development"
