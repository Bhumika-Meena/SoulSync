# ==========================================
# SoulSync 2.0 — Unified Monorepo Environment
# ==========================================

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql://soulsync:soulsync_dev@localhost:5432/soulsync?schema=public"

# NestJS API Gateway
PORT=4000
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="replace-with-a-secure-random-secret"
INTERNAL_AGENT_SECRET="replace-with-a-shared-hmac-secret"

# Next.js Web Client
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-nextauth-secret"

# Python Agent Service (FastAPI + LangGraph)
AGENT_SERVICE_URL="http://localhost:8000"
NEST_API_INTERNAL_URL="http://localhost:4000"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
